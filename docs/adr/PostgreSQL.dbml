// Covers ADR 0001 (users/employees/contacts/companies core), ADR 0002
// (address storage), ADR 0003 (contact lifecycle — deferred).
// Project-access pivot intentionally omitted — not yet designed
// (tracked as a follow-up ADR).
//
// v0.10 changes:
//   - account_status changed from varchar(40) to enum on companies
//   - account_status (nullable) added to contacts, per ADR 0003
//   - billing/physical address columns added to companies, per ADR 0002
//   - address columns added to contacts (individual billing address), per ADR 0002
//
// v0.11 changes:
//   - Address fields scoped to US-only for now (deliberate decision, not an
//     oversight): no `country` column, state fields capped at varchar(2)
//     (USPS abbreviation), renamed state_province -> state and
//     postal_code -> zip to match how the team actually talks about these
//     fields. To be revisited when the Java version (V2-V3) is built,
//     if/when non-US clients become a real possibility.
//
// v0.12 changes:
//   - Project/proposal pipeline added (site_intakes, proposals, projects,
//     project_field_crew, project_survey_details, project_parcels,
//     project_fema_references, project_invoice_followups, project_lots,
//     project_lot_deliverables, employee_licenses, number_sequences).
//     Reasoning lives in ADR 0004, not here — this file stays
//     structure-only, same as the rest of it.
//   - Workflow chain: contact -> site_intake -> proposal -> project.
//     Each table points to the one before it; client and site data are
//     not copied forward.
//   - Audit/status history handled by spatie/laravel-activitylog, not
//     one-off history tables.
//   - contacts aligned with its committed migration: phone varchar(10)
//     not null, contact_role nullable, account_status nullable.
//     No other edits to users, employees, companies, contacts, or the
//     spatie tables.
//   - V1 scope additions: project_adjoiners, project_research_notes,
//     project_documents, project_cad_setups, project_invoices,
//     parcel_transfers (ownership chain). projects gains
//     field_scheduled_date and archived_at.
//   - Change orders: proposals.change_order_project_id (nullable) points
//     a proposal at an existing project. projects.proposal_id is unique —
//     one project per original proposal.
//   - Package tables shown for completeness: activity_log
//     (spatie/laravel-activitylog), personal_access_tokens (Sanctum).
//   - Out of V1 (later versions): client portal, control points, plat
//     notes/legend, plat items, impervious, field code check, county
//     links, deed extractor, lead follow-up log, time tracking, route
//     planning, point clouds, login history. Issues tracked outside
//     SurveyOS.

Enum user_type {
  employee
  contact
}

Enum employee_position {
  office_admin
  researcher
  cad
  field
  pls
}

Enum contact_role {
  project_manager
  accounting
  title_agent
  realtor
  attorney
  lender
}

Enum account_status {
  active
  inactive
  prospect
  suspended
}

Table users {
  id bigint [pk, increment]
  name varchar(160) [not null]
  email varchar(190) [not null, unique]
  email_verified_at timestamp [null]
  password varchar(255) [null, note: 'Nullable — contacts get a users row before they have a password set. See ADR 0001. Stock Laravel migration does NOT mark this nullable by default — must add ->nullable().']
  type user_type [not null, note: 'Fast routing signal only. Not a source of truth for permissions.']
  remember_token varchar(100) [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    email [unique]
    type
  }

  note: 'Fortify-owned auth table. Kept minimal by design — see ADR 0001. Features::updateProfileInformation() is disabled globally; name/email changes go through staff, not self-service.'
}

Table password_reset_tokens {
  email varchar(190) [pk]
  token varchar(255) [not null]
  created_at timestamp [null]

  note: 'Stock Fortify/Laravel table. No formal FK to users.email by design — Laravel matches this by value at query time via the Password broker, not a DB constraint. Tokens expire on their own (config-driven TTL), so no delete-cascade behavior is needed.'
}

Table sessions {
  id varchar(255) [pk]
  user_id bigint [null]
  ip_address varchar(45) [null]
  user_agent text [null]
  payload longtext [not null]
  last_activity int [not null]

  indexes {
    user_id
    last_activity
  }

  note: 'Stock Fortify/Laravel table. user_id cascades on delete when the parent user is hard-deleted. Portal-access revocation (contacts.portal_enabled -> false) is handled in application code (ContactObserver), not by this FK — flipping the flag does not delete the users row, so no cascade fires.'
}

Table employees {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  position employee_position [not null, note: 'Descriptive only — NOT the permission source of truth. See spatie roles.']
  initials varchar(3) [not null, note: 'Used throughout legacy project docs (project_manager_initials, drafter_initials, etc.)']
  is_active boolean [not null, default: true]
  created_at timestamp
  updated_at timestamp

  indexes {
    position
    is_active
  }

  note: 'Staff profile data. Roles/permissions attach here via spatie HasRoles trait, not via the position column.'
}

Table companies {
  id bigint [pk, increment]
  name varchar(220) [not null]
  account_status account_status [not null, default: 'active']
  main_email varchar(190) [null]
  main_phone varchar(80) [null]
  accounting_email varchar(190) [null]

  billing_address_line_1 varchar(255) [not null]
  billing_address_line_2 varchar(255) [null]
  billing_city varchar(120) [not null]
  billing_state varchar(2) [not null, note: 'USPS state abbreviation. US-only for now — see v0.11 changelog note at top of file.']
  billing_zip varchar(10) [not null]

  physical_address_line_1 varchar(255) [null]
  physical_address_line_2 varchar(255) [null]
  physical_city varchar(120) [null]
  physical_state varchar(2) [null]
  physical_zip varchar(10) [null]

  billing_notes text [null]
  notes text [null]
  restrict_contacts_to_assigned_projects boolean [not null, default: false, note: 'Company-level default for project visibility. See contact_project_access (future) and contacts.can_view_all_company_projects override.']
  created_at timestamp
  updated_at timestamp

  indexes {
    name
    account_status
  }

  note: 'Billing address required, physical address optional. Inline columns chosen over a separate polymorphic addresses table — see ADR 0002 for the full tradeoff and the documented upgrade path if this needs to change later.'
}

Table contacts {
  id bigint [pk, increment]
  user_id bigint [not null, unique]
  company_id bigint [null, note: 'NULL = individual client. This is the standard, documented way to query individuals — see ADR 0001.']
  phone varchar(10) [not null]
  title varchar(160) [null]
  contact_role contact_role [null]
  account_status account_status [null, note: 'Only meaningful when company_id IS NULL (individuals). Company-affiliated contacts inherit status from companies.account_status — no per-contact override exists. See ADR 0003 for the reasoning and the deferred future revisit.']
  portal_enabled boolean [not null, default: false, note: 'The actual access gate, checked in Fortify::authenticateUsing(). See ADR 0001.']
  notification_email varchar(190) [null, note: 'NULL = use users.email (login email) for notifications. Only set when correspondence email genuinely differs from login. Read via Contact::effective_notification_email accessor, never directly.']
  can_view_accounting boolean [not null, default: false]
  can_view_all_company_projects boolean [null, note: 'NULL = inherit companies.restrict_contacts_to_assigned_projects. Explicit true/false overrides per-contact.']

  address_line_1 varchar(255) [null]
  address_line_2 varchar(255) [null]
  city varchar(120) [null]
  state varchar(2) [null, note: 'USPS state abbreviation. US-only for now — see v0.11 changelog note at top of file.']
  zip varchar(10) [null]

  notes text [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    company_id
    (company_id, contact_role)
  }

  note: 'Primary client table — both individuals and company contacts live here. Name/login email come from the related users row, not duplicated here. Address fields represent an individual’s billing address (only populated when company_id IS NULL) — see ADR 0002. See ADR 0001 for the overall table design and ADR 0003 for the contact-lifecycle deferral.'
}

// --- spatie/laravel-permission (generated by the package's own migration; shown here for ERD completeness) ---

Table roles {
  id bigint [pk, increment]
  name varchar(125) [not null]
  guard_name varchar(125) [not null]
  created_at timestamp
  updated_at timestamp
}

Table permissions {
  id bigint [pk, increment]
  name varchar(125) [not null]
  guard_name varchar(125) [not null]
  created_at timestamp
  updated_at timestamp
}

Table model_has_roles {
  role_id bigint [not null]
  model_type varchar(190) [not null]
  model_id bigint [not null]

  indexes {
    (model_id, model_type)
    (role_id, model_id, model_type) [pk]
  }

  note: 'Polymorphic — attached to Employee::class, not User::class. Supports multiple roles per employee natively.'
}

Table model_has_permissions {
  permission_id bigint [not null]
  model_type varchar(190) [not null]
  model_id bigint [not null]

  indexes {
    (model_id, model_type)
    (permission_id, model_id, model_type) [pk]
  }
}

Table role_has_permissions {
  permission_id bigint [not null]
  role_id bigint [not null]

  indexes {
    (permission_id, role_id) [pk]
  }
}

// ---------------------------------------------------------------------
// Project / proposal pipeline — new in v0.12, see ADR 0004
// Order follows the workflow: site intake -> proposal -> project.
// ---------------------------------------------------------------------

Enum proposal_status {
  draft
  sent
  viewed
  accepted
  declined
  expired
}

Enum proposal_acceptance_source {
  portal
  employee_entry
}

Enum project_status {
  research
  ready_for_schedule
  scheduled
  ready_for_drafting
  ready_for_review
  ready_for_invoice
  awaiting_payment
  ready_to_deliver
  delivered
}

Enum project_priority {
  high
  urgent
}

Enum lot_deliverable_type {
  lot_fit
  plot_plan
  house_stake
  pin_footings
  final_mortgage_survey
}

Enum document_type {
  research
  final_deliverable
}

Enum location_source {
  geocoded
  manual
}

Table number_sequences {
  sequence_type varchar(20) [not null, note: 'project, proposal — extend if another numbered document shows up, an invoice number for instance']
  year int [not null]
  next_number int [not null, default: 1]

  indexes {
    (sequence_type, year) [pk]
  }

  note: 'Atomic per-year counter backing project_no and proposal_no. See ADR 0004, Decision 2.'
}

Table site_intakes {
  id bigint [pk, increment]
  contact_id bigint [not null, note: 'The client this intake is for. Proposals reach the client through this link — no contact_id on proposals.']

  address_line_1 varchar(255) [null]
  address_line_2 varchar(255) [null]
  city varchar(120) [not null]
  county varchar(120) [not null, note: 'Required — county must appear on the plat.']
  state varchar(2) [not null, note: 'USPS state abbreviation. US-only for now — see v0.11 changelog note at top of file.']
  zip varchar(10) [null]
  township varchar(120) [null, note: 'Often unknown at intake; filled in later. Required on the plat.']
  pin varchar(60) [null, note: 'Parcel ID. Required in app code when address_line_1 is empty — the database cannot enforce this conditional rule.']

  notes text [null, note: 'Site access details such as gate codes.']
  created_at timestamp
  updated_at timestamp

  indexes {
    contact_id
  }

  note: 'What Susie collects about the property. Proposals point here rather than storing address fields themselves.'
}

Table proposals {
  id bigint [pk, increment]
  proposal_no varchar(8) [not null, unique, note: 'P-YYNNNN. Generated at creation from number_sequences. See ADR 0004.']

  site_intake_id bigint [not null, note: 'Client and site data are read through the intake — not stored here. A change order reuses the intake of its project.']
  change_order_project_id bigint [null, note: 'NULL = original proposal; accepting it creates the project. Set = change order against an existing project; accepting it does not create a project. A project can have many.']

  service_type varchar(140) [null]
  scope_description text [null]
  exclusions_description text [null]
  fee_amount decimal(10,2) [null]

  status proposal_status [not null, default: 'draft']
  sent_at timestamp [null]
  viewed_at timestamp [null]

  accepted_at timestamp [null]
  accepted_via proposal_acceptance_source [null]
  accepted_by_employee_id bigint [null, note: 'set when accepted_via is employee_entry']
  accepted_note text [null, note: 'e.g. "confirmed by phone 8/5" — paper trail for an employee-logged acceptance']
  accepted_ip_address varchar(45) [null]

  declined_at timestamp [null]
  declined_reason text [null]

  created_at timestamp
  updated_at timestamp

  indexes {
    site_intake_id
    change_order_project_id
    status
  }

  note: 'A projects row does not exist until one of these is accepted — see ADR 0004, Decision 1.'
}

Table projects {
  id bigint [pk, increment]
  project_no varchar(6) [not null, unique, note: 'YYNNNN. Generated at creation from number_sequences. See ADR 0004.']
  project_name varchar(220) [not null]

  proposal_id bigint [not null, unique, note: 'The accepted original proposal this project was created from. One project per proposal. Change orders point here via proposals.change_order_project_id instead. Client and site data are read through proposal -> site_intake, not copied here.']

  status project_status [not null, default: 'research']
  status_changed_at timestamp [null]
  priority project_priority [null, note: 'off by default — null means normal FIFO. See ADR 0004, Decision 3.']
  field_scheduled_date date [null, note: 'Planned field visit. survey_details.field_date records when it actually happened.']

  invoiced_at timestamp [null]
  last_followed_up_at timestamp [null]

  customer_status varchar(120) [not null, default: 'Project started', note: 'client-portal-facing wording, separate from status on purpose']
  target_delivery date [null]

  project_manager_id bigint [null]
  researcher_id bigint [null]

  is_active boolean [not null, default: true]
  archived_at timestamp [null, note: 'Not null = archived and read-only. Superusers can unarchive. Who and when is recorded by activity_log.']

  created_at timestamp
  updated_at timestamp

  indexes {
    proposal_id
    status
    (status, last_followed_up_at)
  }

  note: 'See ADR 0004 for status/priority behavior and why project_no is generated, not just formatted. Status/priority history is recorded by spatie/laravel-activitylog.'
}

Table project_field_crew {
  project_id bigint [not null]
  employee_id bigint [not null]

  indexes {
    (project_id, employee_id) [pk]
    employee_id
  }

  note: 'Link table between projects and employees. One person today, sized for a full crew later.'
}

Table project_survey_details {
  id bigint [pk, increment]
  project_id bigint [not null, unique]

  drawing_title varchar(220) [null, note: 'falls back to projects.project_name when null']
  ordered_by_name varchar(190) [null, note: 'title-block-only, per county/municipal convention — see ADR 0004']

  zoning_district varchar(60) [null]
  setback_front_ft decimal(6,2) [null]
  setback_side_ft decimal(6,2) [null]
  setback_rear_ft decimal(6,2) [null]
  setback_notes text [null]

  ngs_monument_name varchar(80) [null]
  ngs_combined_scale_factor decimal(10,8) [null]
  horizontal_datum varchar(60) [null, note: 'app-level picklist, not an enum — see ADR 0004, Decision 4']
  vertical_datum varchar(60) [null]
  basis_of_bearing text [null]
  benchmark_description varchar(190) [null]

  certifying_surveyor_id bigint [null, note: 'restricted to pls-position employees at the app layer. License number resolved via employee_licenses']

  field_date date [null]
  survey_date date [null, note: 'nullable — UI shows "TBD" label when null, does not store the word']
  draft_date date [null]
  checked_date date [null]
  drafter_id bigint [null]
  checker_id bigint [null]
  revision varchar(20) [null]
  sheet_no int [null]
  total_sheets int [null]
  scale_text varchar(40) [null]

  field_draft_started boolean [not null, default: false, note: 'true when the field crew chief already ran Field-to-Finish — see ADR 0004']
  recording_requested boolean [null]

  created_at timestamp
  updated_at timestamp

  note: 'Replaces the legacy project_titleblock_values EAV table. See ADR 0004, Decision 4.'
}

Table project_parcels {
  id bigint [pk, increment]
  project_id bigint [not null]
  sort_order int [not null, default: 0]

  parcel_label varchar(60) [null]
  subject_pin varchar(80) [null]
  current_owner_name varchar(220) [null]
  subdivision_name varchar(190) [null]
  lot_number varchar(40) [null]
  site_area_acres decimal(10,4) [null]

  deed_book varchar(20) [null]
  deed_page varchar(20) [null]
  plat_book varchar(20) [null]
  plat_page varchar(20) [null]

  created_at timestamp
  updated_at timestamp

  indexes {
    project_id
    subject_pin
    (deed_book, deed_page)
    (plat_book, plat_page)
  }

  note: 'One row per parcel — a project can cover more than one. See ADR 0004, Decision 4.'
}

Table project_fema_references {
  id bigint [pk, increment]
  project_id bigint [not null]
  sort_order int [not null, default: 0]

  fema_map_number varchar(40) [not null]
  fema_effective_date date [null]

  indexes {
    project_id
  }

  note: 'Deliberately decoupled from project_parcels — a FIRM panel line does not necessarily follow a parcel boundary.'
}

Table project_invoice_followups {
  id bigint [pk, increment]
  project_id bigint [not null]
  employee_id bigint [not null, note: 'who made contact with the client']
  note text [null]
  followed_up_at timestamp [not null]

  indexes {
    project_id
  }

  note: 'Visible to every employee, not a restricted subset — see ADR 0004, Decision 5.'
}

Table project_lots {
  id bigint [pk, increment]
  project_id bigint [not null]

  lot_number varchar(40) [not null]
  house_plan varchar(120) [null]
  homeowner_name varchar(220) [null, note: 'Title block only. Homeowners are not contacts and get no portal access.']

  created_at timestamp
  updated_at timestamp

  indexes {
    project_id
  }

  note: 'Builder subdivision projects only.'
}

Table project_lot_deliverables {
  id bigint [pk, increment]
  project_lot_id bigint [not null]
  type lot_deliverable_type [not null]
  date_ordered date [null]
  date_completed date [null, note: 'Not null = complete. The UI derives the complete state from this.']

  created_at timestamp
  updated_at timestamp

  indexes {
    (project_lot_id, type) [unique]
  }

  note: 'Up to five rows per lot, one per deliverable type.'
}

Table employee_licenses {
  id bigint [pk, increment]
  employee_id bigint [not null]
  state varchar(2) [not null]
  license_number varchar(40) [not null]

  indexes {
    (employee_id, state) [unique]
  }

  note: 'PLS license number by state. Self-service on the employee profile, shown when position is pls. See ADR 0004, Decision 6.'
}

Table project_cad_setups {
  id bigint [pk, increment]
  project_id bigint [not null, unique]

  latitude decimal(10,7) [null, note: 'WGS84. No elevation stored.']
  longitude decimal(10,7) [null, note: 'WGS84.']
  location_source location_source [null, note: 'manual = override. The geocode button never overwrites a manual location.']
  geocoded_at timestamp [null]

  created_at timestamp
  updated_at timestamp

  note: 'Satellite record off projects. Geocodio, rooftop results only, triggered by a button on the CAD setup screen. State for template selection is read through proposal -> site_intake, not copied here.'
}

Table project_adjoiners {
  id bigint [pk, increment]
  project_parcel_id bigint [not null, note: 'The subject parcel this adjoiner borders.']

  owner_name varchar(220) [null]
  pin varchar(80) [null]
  deed_book varchar(20) [null]
  deed_page varchar(20) [null]
  plat_book varchar(20) [null]
  plat_page varchar(20) [null]
  subdivision_name varchar(190) [null]
  lot_number varchar(40) [null]
  zoning varchar(60) [null]

  created_at timestamp
  updated_at timestamp

  indexes {
    project_parcel_id
  }

  note: 'Entered by research. Feeds the adjoiner block data in Civil 3D.'
}

Table parcel_transfers {
  id bigint [pk, increment]
  project_parcel_id bigint [not null, note: 'Subject parcels only — no chains for adjoiners.']

  grantor varchar(220) [not null]
  grantee varchar(220) [not null]
  deed_book varchar(20) [not null]
  deed_page varchar(20) [not null]
  plat_book varchar(20) [null, note: 'Optional — ownership transfers by deed only. A plat is a graphical representation of a deed and may not be recorded.']
  plat_page varchar(20) [null]
  recorded_date date [not null, note: 'Orders the chain. Same-day records fall back to entry order (id).']

  instrument_type varchar(60) [null, note: 'app-level picklist (deed, will, easement, ...), not an enum — same approach as datums']
  project_document_id bigint [null, note: 'Optional link to the stored document for this transfer.']
  notes text [null]

  created_at timestamp
  updated_at timestamp

  indexes {
    (project_parcel_id, recorded_date)
  }

  note: 'Ownership chain (grantor/grantee lineage) for a subject parcel. One row = one transfer. Entered by research; reviewed by CAD and the PLS.'
}

Table project_research_notes {
  id bigint [pk, increment]
  project_id bigint [not null]
  employee_id bigint [not null, note: 'Who wrote the entry.']
  body text [not null]

  created_at timestamp
  updated_at timestamp

  indexes {
    project_id
  }

  note: 'Dated research note entries, not one running field.'
}

Table project_documents {
  id bigint [pk, increment]
  project_id bigint [not null]
  type document_type [not null]

  path varchar(500) [not null, note: 'Object key in the S3-compatible bucket. The file itself is not stored in the database.']
  original_filename varchar(255) [not null]
  mime_type varchar(120) [null]
  size_bytes bigint [null]

  uploaded_by_employee_id bigint [null]

  created_at timestamp
  updated_at timestamp

  indexes {
    (project_id, type)
  }

  note: 'V1 covers research documents and final deliverables only.'
}

Table project_invoices {
  id bigint [pk, increment]
  project_id bigint [not null]

  akaunting_invoice_no varchar(40) [not null, note: 'The invoice lives in Akaunting; this links to it.']
  amount decimal(10,2) [not null]
  paid_at date [null, note: 'Entered by staff when the client pays. Not synced from Akaunting.']

  created_at timestamp
  updated_at timestamp

  indexes {
    project_id
    akaunting_invoice_no [unique]
  }

  note: 'A project can have more than one invoice (deposit, final, etc.).'
}

// --- spatie/laravel-activitylog (generated by the package's own migration; shown here for ERD completeness) ---

Table activity_log {
  id bigint [pk, increment]
  log_name varchar(255) [null]
  description text [not null]
  subject_type varchar(255) [null]
  subject_id bigint [null]
  event varchar(255) [null]
  causer_type varchar(255) [null]
  causer_id bigint [null]
  attribute_changes json [null]
  properties json [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    log_name
    (subject_type, subject_id)
    (causer_type, causer_id)
  }

  note: 'Polymorphic — subject is the changed model, causer is who changed it. Replaces one-off history tables.'
}

// --- laravel/sanctum (generated by the package's own migration; shown here for ERD completeness) ---

Table personal_access_tokens {
  id bigint [pk, increment]
  tokenable_type varchar(255) [not null]
  tokenable_id bigint [not null]
  name text [not null]
  token varchar(64) [not null, unique]
  abilities text [null]
  last_used_at timestamp [null]
  expires_at timestamp [null]
  created_at timestamp
  updated_at timestamp

  indexes {
    (tokenable_type, tokenable_id)
    expires_at
  }

  note: 'Polymorphic — tokenable is Employee::class (HasApiTokens on Employee, not User). Tokens deleted on employee deactivation.'
}

// --- Relationships ---

Ref: employees.user_id ?- users.id [delete: cascade]
Ref: contacts.user_id ?- users.id [delete: cascade]
Ref: contacts.company_id >? companies.id [delete: set null]
Ref: sessions.user_id >? users.id [delete: cascade]

Ref: model_has_roles.role_id > roles.id [delete: cascade]
Ref: model_has_permissions.permission_id > permissions.id [delete: cascade]
Ref: role_has_permissions.permission_id > permissions.id [delete: cascade]
